{
  "name": "ogham",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Transliterate text into ogham, drawn as SVG.",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:embed": "esbuild public/embed/src/element.js --bundle --format=iife --global-name=Ogham --outfile=public/embed/ogham.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "esbuild": "^0.23.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.42.0"
  }
}
